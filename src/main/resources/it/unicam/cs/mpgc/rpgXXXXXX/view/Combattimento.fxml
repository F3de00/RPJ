<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" alignment="CENTER" spacing="16" styleClass="schermata" stylesheets="@stile.css">
    <HBox fx:id="contenitoreNemici" alignment="CENTER" spacing="16"/>
    <Label fx:id="etichettaEroe" styleClass="testo"/>
    <HBox fx:id="contenitoreAzioni" alignment="CENTER" spacing="16"/>
    <TextArea fx:id="registro" editable="false" prefHeight="160" maxWidth="600" styleClass="registro"/>
    <Label fx:id="etichettaEsito" styleClass="titolo"/>
    <Button fx:id="pulsanteContinua" text="Continua" onAction="#continua" visible="false" styleClass="pulsante"/>
</VBox>
